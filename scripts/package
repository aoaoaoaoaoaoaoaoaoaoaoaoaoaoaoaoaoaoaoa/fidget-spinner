#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cell=$(mktemp -d "${TMPDIR:-/tmp}/fidget-spinner-package.XXXXXX")
trap 'rm -rf -- "$cell"' EXIT HUP INT TERM
cd "$root"

cargo install --locked --path crates/fidget-spinner --root "$cell/prefix"
binary="$cell/prefix/bin/fidget-spinner"
if [ "${OS:-}" = Windows_NT ]; then
    binary=$binary.exe
fi
"$binary" --version
cargo uninstall --root "$cell/prefix" fidget-spinner
test ! -e "$binary"
